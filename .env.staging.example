APP_NAME="VAS Partners"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vaspartnersportal.ethiotelecom.et
FRONTEND_URL=https://vaspartnersportal.ethiotelecom.et
MAX_OPEN_TICKETS=1
# HTTP abuse caps on POST /tickets only (not subscription quotas).
# Business rule (enforced in app + DB): one alive subscription per service per company TIN.
TICKET_CREATE_PER_CONTACT_PER_MINUTE=5
TICKET_CREATE_PER_COMPANY_PER_MINUTE=10
TICKET_CREATE_PER_IP_PER_MINUTE=20
# Comma-separated last-9 phones exempt from open subscription request cap (test accounts)
OPEN_TICKET_LIMIT_EXEMPT_PHONES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# Overridden by compose.staging.yml to container service names.
DB_CONNECTION=pgsql
DB_HOST=pgbouncer
DB_PORT=5432
DB_DATABASE=vaspartners
DB_USERNAME=vas
DB_PASSWORD=secret
DB_EMULATE_PREPARES=false

SESSION_DRIVER=redis
SESSION_LIFETIME=120

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=vaspartnersportal.ethiotelecom.et
# Partner portal Sanctum token lifetime (minutes). Default 24 hours.
SANCTUM_TOKEN_EXPIRATION=1440
TRUSTED_PROXIES=*

# Ethio telecom BSS GetCustomer (same as fixedservices) — OTP identity KYC
CRM_ENABLED=true
NG_ENDPOINT=
NG_ACCESS_USER=PortalFixedService
NG_ACCESS_PWD=
NG_CHANNEL_ID=116
NG_TECHNICAL_CHANNEL_ID=53
NG_TENANT_ID=101
NG_LANGUAGE=2002
CRM_TIMEOUT=15

# eTrade national TIN / registration lookup (etrade.gov.et)
ETRADE_ENABLED=true
ETRADE_BASE_URL=https://etrade.gov.et
# Working upstream path (api/v1/taxpayers/tin/{tin} currently 404s on eTrade)
ETRADE_TIN_PATH=/api/Tin/checkTin/{tin}
ETRADE_REGISTRATIONS_PATH=/api/Registration/GetRegistrationsByTin/{tin}
ETRADE_TIMEOUT=20
ETRADE_VERIFY_SSL=false
ETRADE_INCLUDE_REGISTRATIONS=true
# Anti-flood: cache TIN lookups, cap scheduled/global ERCA calls
ETRADE_TIN_CACHE_HOURS=6
ETRADE_GLOBAL_LOOKUPS_PER_MINUTE=8
ETRADE_RECHECK_HOURS=168
ETRADE_RETRY_HOURS=6
ETRADE_SCHEDULE_LIMIT=10
ETRADE_SCHEDULE_SLEEP_MS=1500

# Fayda / eSignet staging (IDA) — register this redirect on the Fayda client
FAYDA_CLIENT_ID=
FAYDA_REDIRECT_URI=https://vaspartnersportal.ethiotelecom.et/callback
FAYDA_AUTH_URL=https://esignet.ida.fayda.et/authorize
FAYDA_TOKEN_URL=https://esignet.ida.fayda.et/v1/esignet/oauth/v2/token
FAYDA_USERINFO_URL=https://esignet.ida.fayda.et/v1/esignet/oidc/userinfo
FAYDA_PRIVATE_KEY=
FAYDA_ALG=RS256
FAYDA_ASSERTION_TYPE=urn:ietf:params:oauth:client-assertion-type:jwt-bearer
FAYDA_EXPIRATION_TIME=15

FILAMENT_SPA=false
DEFAULT_RENEWAL_INTERVAL=yearly

FILAMENT_IMPERSONATE_REDIRECT=/admin
FILAMENT_IMPERSONATE_BANNER_STYLE=dark

SMS_ENDPOINT=https://smsgw.ethiotelecom.et/bl/index.php?receiver=
SMS_ENABLED=true
SMS_QUEUE_OTP=sms-otp
SMS_QUEUE_BULK=sms
SMS_QUEUE_DEFAULT=sms

VAS_SEED_ON_START=true
