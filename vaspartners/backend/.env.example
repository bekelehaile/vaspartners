APP_NAME="VAS Partners"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
MAX_OPEN_TICKETS=1
# HTTP abuse caps on POST /tickets only (not subscription quotas).
# Business rule (enforced in app + DB): one alive subscription per service per company TIN.
TICKET_CREATE_PER_CONTACT_PER_MINUTE=5
TICKET_CREATE_PER_COMPANY_PER_MINUTE=10
TICKET_CREATE_PER_IP_PER_MINUTE=20
# Test contacts (last-9 phone) allowed unlimited open subscription requests
OPEN_TICKET_LIMIT_EXEMPT_PHONES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Docker Compose service names (container network).
# From the host (optional tools): postgres :5433, pgbouncer :6432, redis :6380
DB_CONNECTION=pgsql
DB_HOST=pgbouncer
DB_PORT=5432
DB_DATABASE=vaspartners
DB_USERNAME=vas
DB_PASSWORD=secret
DB_EMULATE_PREPARES=false

SESSION_DRIVER=redis
SESSION_LIFETIME=120

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
# Inside Docker Compose this must be the service name + internal port.
# Compose also sets these; host-only redis-cli can use 127.0.0.1:6380.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Partner portal API tokens expire after this many minutes (default 24h).
SANCTUM_TOKEN_EXPIRATION=1440

# Fayda / eSignet — local registered redirect is the Next.js bridge page
FAYDA_CLIENT_ID=
FAYDA_REDIRECT_URI=http://localhost:3000/callback
FAYDA_AUTH_URL=https://esignet.ida.fayda.et/authorize
FAYDA_TOKEN_URL=https://esignet.ida.fayda.et/v1/esignet/oauth/v2/token
FAYDA_USERINFO_URL=https://esignet.ida.fayda.et/v1/esignet/oidc/userinfo
FAYDA_PRIVATE_KEY=
FAYDA_ALG=RS256
FAYDA_ASSERTION_TYPE=urn:ietf:params:oauth:client-assertion-type:jwt-bearer
FAYDA_EXPIRATION_TIME=15

FILAMENT_SPA=false
DEFAULT_RENEWAL_INTERVAL=yearly

# Filament user impersonation (stechstudio/filament-impersonate)
FILAMENT_IMPERSONATE_REDIRECT=/admin
FILAMENT_IMPERSONATE_BANNER_STYLE=dark

# Ethio telecom SMS gateway (partner notifications)
SMS_ENDPOINT=https://smsgw.ethiotelecom.et/bl/index.php?receiver=
SMS_ENABLED=true
SMS_COUNTRY_CODE=251
# Queues: otp has a dedicated worker; bulk/default share multiple sms workers
SMS_QUEUE_OTP=sms-otp
SMS_QUEUE_BULK=sms
SMS_QUEUE_DEFAULT=sms
# Max SMS per Ethiopian number / hour
SMS_RATE_PER_PHONE_MAX=20
SMS_RATE_PER_PHONE_DECAY=3600
# Max SMS globally / minute
SMS_RATE_GLOBAL_MAX=120
SMS_RATE_GLOBAL_DECAY=60
