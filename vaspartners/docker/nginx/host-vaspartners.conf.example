# ============================================================================
# Host Nginx — VAS Partners (gate / :443)
# ============================================================================
#
# Install:
#   sudo cp docker/nginx/host-vaspartners.conf.example \
#     /etc/nginx/conf.d/vaspartners.conf
#   sudo rm -f /etc/nginx/conf.d/mvasportal.conf   # old MVAS site — remove
#   sudo nginx -t && sudo systemctl reload nginx
#
# Public: https://vaspartnersportal.ethiotelecom.et
# Upstream: Docker vaspartners-nginx on 127.0.0.1:30011
# ============================================================================

server {
    listen 80;
    server_name vaspartnersportal.ethiotelecom.et;
    return 301 https://vaspartnersportal.ethiotelecom.et$request_uri;
}

server {
    listen 443 ssl http2;
    ssl_certificate /etc/nginx/ssl/fullchain-wildcard.crt;
    ssl_certificate_key /etc/nginx/ssl/ethiotelecom-wildcard.key;

    server_name vaspartnersportal.ethiotelecom.et www.vaspartnersportal.ethiotelecom.et;
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-XSS-Protection "1; mode=block";
    add_header X-Content-Type-Options "nosniff";
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:30011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        proxy_hide_header Content-Security-Policy;
    }
}
